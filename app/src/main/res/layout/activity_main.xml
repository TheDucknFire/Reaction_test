<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#202124">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REACTION TEST"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="20dp" />


    <!-- SCELTA MODALITÀ -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnModalitaSemplice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Semplice" />

        <Button
            android:id="@+id/btnModalitaAvanzata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="4 Aree" />

    </LinearLayout>


    <!-- STATO DEL GIOCO -->

    <TextView
        android:id="@+id/txtStato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Premi START per iniziare"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />


    <!-- RISULTATO -->

    <TextView
        android:id="@+id/txtRisultato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--- ms"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />


    <!-- PULSANTE START -->

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="START"
        android:textSize="20sp"
        android:layout_marginBottom="20dp" />


    <!-- MODALITÀ SEMPLICE -->

    <Button
        android:id="@+id/btnReaction"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="ATTENDI"
        android:textSize="28sp"
        android:textStyle="bold" />


    <!-- MODALITÀ 4 AREE -->

    <LinearLayout
        android:id="@+id/layoutQuattroAree"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- RIGA 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnArea1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="AREA 1"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnArea2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="AREA 2"
                android:textSize="20sp" />

        </LinearLayout>


        <!-- RIGA 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnArea3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="AREA 3"
                android:textSize="20sp" />

            <Button
                android:id="@+id/btnArea4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="5dp"
                android:text="AREA 4"
                android:textSize="20sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>